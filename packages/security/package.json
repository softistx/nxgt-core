{
	"name": "@nxgt/security",
	"version": "2.0.0",
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"schema",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./policy": {
			"types": "./dist/policy/index.d.ts",
			"import": "./dist/policy/index.js",
			"default": "./dist/policy/index.js"
		},
		"./policy/graphql": {
			"types": "./dist/policy/graphql/index.d.ts",
			"import": "./dist/policy/graphql/index.js",
			"default": "./dist/policy/graphql/index.js"
		},
		"./integrations/hono": {
			"types": "./dist/integrations/hono/index.d.ts",
			"import": "./dist/integrations/hono/index.js",
			"default": "./dist/integrations/hono/index.js"
		},
		"./integrations/hono/keto": {
			"types": "./dist/integrations/hono/keto.d.ts",
			"import": "./dist/integrations/hono/keto.js",
			"default": "./dist/integrations/hono/keto.js"
		},
		"./integrations/graphql/keto": {
			"types": "./dist/integrations/graphql/keto.d.ts",
			"import": "./dist/integrations/graphql/keto.js",
			"default": "./dist/integrations/graphql/keto.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-core.git",
		"directory": "packages/security"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"schema:gen": "bun run src/policy/schema/generate.ts && biome check --write schema/rules.schema.json",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/policy/index.ts",
			"src/policy/graphql/index.ts",
			"src/integrations/hono/index.ts",
			"src/integrations/hono/keto.ts",
			"src/integrations/graphql/keto.ts"
		]
	},
	"dependencies": {
		"@graphql-tools/utils": "^12.0.0",
		"@nxgt/shared": "workspace:^",
		"@nxgt/shared-exceptions": "workspace:^",
		"@nxgt/shared-logging": "workspace:^",
		"graphql": "^17.0.2",
		"hono": "^4.13.4",
		"path-to-regexp": "^8.4.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"stx-sdk": ">=1.1.0"
	},
	"peerDependencies": {
		"stx-sdk": ">=1.1.0",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"stx-sdk": {
			"optional": true
		}
	}
}
