{
	"name": "@nxgt/security",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./policy": {
			"types": "./dist/policy/index.d.ts",
			"import": "./dist/policy/index.js",
			"default": "./dist/policy/index.js"
		},
		"./policy/graphql": {
			"types": "./dist/policy/graphql/index.d.ts",
			"import": "./dist/policy/graphql/index.js",
			"default": "./dist/policy/graphql/index.js"
		},
		"./integrations/hono": {
			"types": "./dist/integrations/hono/index.d.ts",
			"import": "./dist/integrations/hono/index.js",
			"default": "./dist/integrations/hono/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/security"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit",
		"schema:gen": "bun run src/policy/schema/generate.ts && biome check --write src/policy/schema/rules.schema.json"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/policy/index.ts",
			"src/policy/graphql/index.ts",
			"src/integrations/hono/index.ts"
		]
	},
	"dependencies": {
		"@graphql-tools/utils": "^12.0.0",
		"@nxgt/shared": "workspace:*",
		"@nxgt/shared-exceptions": "workspace:*",
		"@nxgt/shared-logging": "workspace:*",
		"graphql": "^17.0.2",
		"hono": "^4.13.4",
		"path-to-regexp": "^8.4.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
