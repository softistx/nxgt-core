{
	"name": "@nxgt/shared-mongo",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./filters": {
			"types": "./dist/filters/index.d.ts",
			"import": "./dist/filters/index.js",
			"default": "./dist/filters/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/shared-mongo"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit",
		"test": "NODE_ENV=test bun --env-file=.env.test test src"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/filters/index.ts"
		]
	},
	"dependencies": {
		"@nxgt/i18n": "workspace:*",
		"@nxgt/shared": "workspace:*",
		"@nxgt/shared-logging": "workspace:*",
		"@nxgt/shared-exceptions": "workspace:*",
		"async-mutex": "^0.5.0",
		"i18next": "^26.3.6",
		"just-diff": "^6.0.2",
		"lodash": "^4.18.1",
		"luxon": "^3.7.2",
		"mongoose": "9.9.2",
		"mongoose-autopopulate": "^1.2.1",
		"mongoose-lean-virtuals": "^2.1.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/lodash": "^4.17.25",
		"@types/luxon": "^3.7.4"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
