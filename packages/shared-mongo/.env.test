# packages/shared-mongo — test
#
# ONLY the database name is particular to this package. Mongo credentials and
# hosts expand from the system environment (see the root `.env.example`).
# With those unset this yields `mongodb://:@/shared-mongo-test`, a URI with no
# host: the Mongo-backed specs skip themselves (`hasMongoHost`), as the S3 ones
# do. Skipping applies only when there is no host at all; a host with a database
# name that does not end in `-test` is still refused by `clearDatabase`.
#
# replicaSet=rs0 is required: the runner wraps each migration in
# session.withTransaction().

NODE_ENV=test
LOG_LEVEL=error

MONGODB_URI=mongodb://$MONGO_USER:$MONGO_PASSWORD@$MONGO_HOSTS/shared-mongo-test?replicaSet=rs0&authSource=admin
