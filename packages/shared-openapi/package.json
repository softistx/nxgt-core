{
	"name": "@nxgt/shared-openapi",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/shared-openapi"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	},
	"peerDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"openapi-typescript": "^7.13.0",
		"typescript": "^6.0.3"
	}
}
