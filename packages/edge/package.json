{
	"name": "@nxgt/edge",
	"version": "0.1.0",
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-core.git",
		"directory": "packages/edge"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./authenticators/ory": {
			"types": "./dist/authenticators/ory.d.ts",
			"import": "./dist/authenticators/ory.js",
			"default": "./dist/authenticators/ory.js"
		},
		"./package.json": "./package.json"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/authenticators/ory.ts"
		]
	},
	"dependencies": {
		"@nxgt/security": "workspace:^",
		"@nxgt/shared": "workspace:^",
		"@nxgt/shared-logging": "workspace:^",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"stx-sdk": ">=1.2.0",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"stx-sdk": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"jose": "^6.2.9",
		"stx-sdk": ">=1.2.0"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	}
}
