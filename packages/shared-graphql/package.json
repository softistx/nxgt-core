{
	"name": "@nxgt/shared-graphql",
	"version": "1.2.0",
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"graphql",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./security": {
			"types": "./dist/security/index.d.ts",
			"import": "./dist/security/index.js",
			"default": "./dist/security/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-core.git",
		"directory": "packages/shared-graphql"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/security/index.ts"
		]
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@apollo/subgraph": "^2.14.3",
		"@envelop/extended-validation": "^7.1.1",
		"@envelop/generic-auth": "^11.1.1",
		"@graphql-hive/gateway": "^2.11.2",
		"@graphql-tools/load-files": "^7.0.1",
		"@graphql-tools/merge": "^9.2.3",
		"@graphql-tools/utils": "^12.0.0",
		"@graphql-yoga/redis-event-target": "^3.0.3",
		"@hono/zod-validator": "^0.9.0",
		"@nxgt/i18n": "workspace:*",
		"@nxgt/security": "workspace:*",
		"@nxgt/shared": "workspace:*",
		"@nxgt/shared-exceptions": "workspace:*",
		"@nxgt/shared-logging": "workspace:*",
		"@nxgt/shared-mongo": "workspace:*",
		"dataloader": "^2.2.3",
		"graphql": "^16.4.2",
		"graphql-scalars": "^1.26.0",
		"graphql-subscriptions": "^3.0.0",
		"graphql-upload": "^18.0.0",
		"graphql-ws": "^6.2.1",
		"graphql-yoga": "^5.21.3",
		"hono": "^4.13.4",
		"ioredis": "^6.0.0",
		"lodash": "^4.18.1",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/graphql-upload": "^17.0.0",
		"@types/lodash": "^4.17.25",
		"@types/ws": "^8.18.1"
	},
	"peerDependencies": {
		"stx-sdk": ">=1.0.0",
		"typescript": "^6.0.3"
	}
}
