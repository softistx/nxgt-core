{
	"name": "@nxgt/shared-events",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js",
			"default": "./dist/core/index.js"
		},
		"./sales": {
			"types": "./dist/sales/index.d.ts",
			"import": "./dist/sales/index.js",
			"default": "./dist/sales/index.js"
		},
		"./finance": {
			"types": "./dist/finance/index.d.ts",
			"import": "./dist/finance/index.js",
			"default": "./dist/finance/index.js"
		},
		"./entities": {
			"types": "./dist/entities/index.d.ts",
			"import": "./dist/entities/index.js",
			"default": "./dist/entities/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/shared-events"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/core/index.ts",
			"src/sales/index.ts",
			"src/finance/index.ts",
			"src/entities/index.ts"
		]
	},
	"dependencies": {
		"bullmq": "^6.1.1",
		"bunqueue": "^2.8.59"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	},
	"peerDependencies": {
		"typescript": "~7.0.2"
	}
}
