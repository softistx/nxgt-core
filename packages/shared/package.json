{
	"name": "@nxgt/shared",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"import": "./dist/helpers/index.js",
			"default": "./dist/helpers/index.js"
		},
		"./models": {
			"types": "./dist/models/index.d.ts",
			"import": "./dist/models/index.js",
			"default": "./dist/models/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		},
		"./caching": {
			"types": "./dist/caching/index.d.ts",
			"import": "./dist/caching/index.js",
			"default": "./dist/caching/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/shared"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/helpers/index.ts",
			"src/models/index.ts",
			"src/types/index.ts",
			"src/caching/index.ts"
		]
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@nxgt/shared-events": "workspace:*",
		"@nxgt/shared-logging": "workspace:*",
		"bullmq": "^6.1.1",
		"camelcase-keys": "^10.0.2",
		"croner": "^10.0.1",
		"handlebars": "^4.7.9",
		"hono": "^4.13.4",
		"lodash": "^4.18.1",
		"mongoose": "9.9.2",
		"nodemailer": "^9.0.5",
		"snakecase-keys": "^9.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/lodash": "^4.17.25",
		"@types/nodemailer": "^8.0.1"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
