# nxgt-core — the environment the specs read, with example values.
#
# Copy what you need into your shell, or into a `.env` (git-ignored). No value
# here is a secret: they describe a local MongoDB and a local S3, never a real
# deployment.

# ── MongoDB ──────────────────────────────────────────────────────────────────
# `packages/shared-mongo/.env.test` builds its MONGODB_URI from these three:
#   mongodb://$MONGO_USER:$MONGO_PASSWORD@$MONGO_HOSTS/shared-mongo-test?replicaSet=rs0&authSource=admin
# The migration suite needs a replica set (rs0): it runs transactions.
MONGO_USER=nxgt
MONGO_PASSWORD=nxgt
MONGO_HOSTS=localhost:27017

# Or set MONGODB_URI yourself, as CI does, for a MongoDB without auth:
#   docker run -d --name mongo -p 27017:27017 mongo:7 --replSet rs0 --bind_ip_all
#   docker exec mongo mongosh --eval 'rs.initiate()'
# MONGODB_URI=mongodb://localhost:27017/shared-mongo-test?replicaSet=rs0

# ── S3 ───────────────────────────────────────────────────────────────────────
# `@nxgt/shared-storage`'s S3 suites run only when all four are set, and are
# skipped otherwise. MinIO is enough:
#   docker run -d -p 9000:9000 minio/minio server /data
S3_ENDPOINT=http://localhost:9000
S3_USER=minioadmin
S3_PASSWORD=minioadmin
S3_BUCKET=nxgt-test
