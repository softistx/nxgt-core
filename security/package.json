{
	"name": "@nxgt/security",
	"module": "src/index.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./src/index.ts"
		},
		"./policy": {
			"import": "./src/policy/index.ts"
		},
		"./policy/graphql": {
			"import": "./src/policy/graphql/index.ts"
		},
		"./integrations/hono": {
			"import": "./src/integrations/hono/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"schema:gen": "bun run src/policy/schema/generate.ts && biome check --write src/policy/schema/rules.schema.json"
	},
	"dependencies": {
		"@graphql-tools/utils": "^12.0.0",
		"@nxgt/shared": "workspace:*",
		"@nxgt/shared-exceptions": "workspace:*",
		"@nxgt/shared-logging": "workspace:*",
		"graphql": "^17.0.2",
		"hono": "^4.13.2",
		"path-to-regexp": "^8.4.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
